# Epyatis MCP Central — local development example
# Generate independent values, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

CENTRAL_ENV=development
CENTRAL_HOST=127.0.0.1
CENTRAL_PORT=8000
CENTRAL_DEBUG=false
CENTRAL_SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
CENTRAL_ADMIN_KEY=replace-with-a-different-random-value-of-at-least-32-characters

# JSON arrays parsed by pydantic-settings.
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Local subprocess connectors are disabled by default. Add only exact,
# reviewed package versions, e.g. ["@scope/reviewed-mcp@1.2.3"].
STDIO_ALLOWED_PACKAGES=[]

# Optional upstream integrations. Never commit real values.
PERISKOPE_API_KEY=
PERISKOPE_MCP_URL=https://api.periskope.app/mcp
GDRIVE_OAUTH_CREDENTIALS_FILE=
GDRIVE_OAUTH_TOKEN_FILE=
